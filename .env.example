# Supabase Project Settings > API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Choose a strong private PIN for the staff/admin dashboard
ADMIN_PIN=change-this-to-a-unique-pin

# Any long random secret (32+ characters). Used to sign the staff session cookie.
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Google Sheets -> server-only synchronization API (32+ random characters)
GOOGLE_SYNC_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Optional Resend integration. Automatic sending remains disabled until enabled in the admin dashboard.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
APP_BASE_URL=https://YOUR_DEPLOYED_HOST
